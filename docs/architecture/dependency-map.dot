    "internal/maintenance" [fillcolor="white", color="#7e22ce"];
    "internal/mcpregistry" [fillcolor="white", color="#7e22ce"];
    "internal/memory" [fillcolor="white", color="#7e22ce"];
    "internal/senders" [fillcolor="white", color="#7e22ce"];
