// go_hive 分层依赖图（生成物，勿手改）
// 源：architecture/model.yaml + go list -json ./... · commit 4c198a558dfd
// 箭头 A -> B 读作 A imports B。
digraph go_hive {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.28, ranksep=0.9, splines=true];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.10,0.05"];
  edge [color="#94a3b8", arrowsize=0.6];
  subgraph cluster_entry {
    label="入口层（entry）";
    style="rounded,filled"; fillcolor="#eef2ff"; color="#4338ca"; fontsize=11;
    "cmd/hive" [fillcolor="white", color="#4338ca"];
    "cmd/hive-cred" [fillcolor="white", color="#4338ca"];
  }
  subgraph cluster_assembly {
    label="装配层（assembly）";
    style="rounded,filled"; fillcolor="#e0f2fe"; color="#0369a1"; fontsize=11;
    "internal/cli" [fillcolor="white", color="#0369a1"];
  }
  subgraph cluster_transport {
    label="传输层（transport）";
    style="rounded,filled"; fillcolor="#dcfce7"; color="#15803d"; fontsize=11;
    "internal/runtimehealth" [fillcolor="white", color="#15803d"];
    "internal/server" [fillcolor="white", color="#15803d"];
    "internal/server/uiembed" [fillcolor="white", color="#15803d"];
  }
  subgraph cluster_orchestration {
    label="编排层（orchestration）";
    style="rounded,filled"; fillcolor="#fef3c7"; color="#b45309"; fontsize=11;
    "internal/agents" [fillcolor="white", color="#b45309"];
    "internal/colony" [fillcolor="white", color="#b45309"];
    "internal/host" [fillcolor="white", color="#b45309"];
    "internal/playbook" [fillcolor="white", color="#b45309"];
