    "internal/queen" [fillcolor="white", color="#b45309"];
    "internal/sentinel" [fillcolor="white", color="#b45309"];
    "internal/session" [fillcolor="white", color="#b45309"];
    "internal/sessionreport" [fillcolor="white", color="#b45309"];
    "internal/tasks" [fillcolor="white", color="#b45309"];
    "internal/tracker" [fillcolor="white", color="#b45309"];
    "internal/triggers" [fillcolor="white", color="#b45309"];
  }
  subgraph cluster_runtime {
    label="执行原语层（runtime）";
    style="rounded,filled"; fillcolor="#fee2e2"; color="#b91c1c"; fontsize=11;
    "internal/agentloop" [fillcolor="white", color="#b91c1c"];
    "internal/llmjudge" [fillcolor="white", color="#b91c1c"];
    "internal/orchestrator" [fillcolor="white", color="#b91c1c"];
  }
  subgraph cluster_capability {
    label="能力层（capability）";
    style="rounded,filled"; fillcolor="#f3e8ff"; color="#7e22ce"; fontsize=11;
