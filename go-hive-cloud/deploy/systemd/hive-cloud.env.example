# /etc/hive-cloud/hive-cloud.env
# Install as root:hive-cloud mode 0640 (or root:root 0600).
#
# This file carries configuration only. Signing secrets are NOT stored here by
# default: hive-cloud generates <data-dir>/jwt_secret and <data-dir>/stream_secret
# on first start (0600) and reuses them across restarts.
#
# HIVE_CLOUD_JWT_SECRET / HIVE_CLOUD_STREAM_SECRET may be supplied here for
# deployments that inject secrets from a KMS/vault at boot. If you do, keep the
# file 0600 and never commit it.

HIVE_CLOUD_LISTEN=127.0.0.1:8788
HIVE_CLOUD_DATA_DIR=/var/lib/hive-cloud

# SQL and inbox limits (match the built-in defaults; override as needed).
HIVE_CLOUD_STATEMENT_TIMEOUT_MS=5000
HIVE_CLOUD_INBOX_RATE_LIMIT=0
HIVE_CLOUD_INBOX_RATE_WINDOW_MS=60000

# Rotate streamTokens by keeping the previous secret valid for one refresh
# window. Prefer the file <data-dir>/stream_secret_previous; set the env only
# when secrets come from an external injector:
# HIVE_CLOUD_STREAM_SECRET_PREVIOUS=<old secret>
