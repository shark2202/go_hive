# Copy to .env for local compose overrides. NEVER commit the real .env.
# These values are non-secret configuration only. Signing secrets are generated
# inside the hive-cloud-data volume (0600 files) on first start.

# Host loopback port published by compose (container always listens on 8788).
HIVE_CLOUD_PORT=8788

# Optional image/build overrides.
HIVE_CLOUD_IMAGE=hive-cloud:local
GO_VERSION=1.26.11

# SQL / inbox limits (empty values fall back to the built-in defaults).
HIVE_CLOUD_STATEMENT_TIMEOUT_MS=5000
HIVE_CLOUD_INBOX_RATE_LIMIT=0
HIVE_CLOUD_INBOX_RATE_WINDOW_MS=60000
